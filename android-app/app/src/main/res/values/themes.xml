<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmmTurk" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#FAFAFA</item>
        <item name="android:colorPrimary">#E30A17</item>
        <item name="android:colorPrimaryDark">#B90812</item>
    </style>

    <style name="Theme.SmmTurk.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand</item>
        <item name="postSplashScreenTheme">@style/Theme.SmmTurk</item>
    </style>
</resources>
